# ──────────────────────────────────────────────────────────────
# Mr Martin — Variables d'environnement (copier vers .env)
# ──────────────────────────────────────────────────────────────
# Renommer ce fichier en ".env" et remplir toutes les valeurs.
# NE JAMAIS commiter le fichier .env dans git.

# ── APIs IA ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ASSEMBLYAI_API_KEY=...

# ── TikTok OAuth ─────────────────────────────────────────────
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...

# ── TikTok publication ───────────────────────────────────────
# Mode publication : 0 = API officielle Content Posting (inbox/brouillon par défaut),
# 1 = bypass Playwright (session navigateur — code conservé en secours).
TIKTOK_USE_PLAYWRIGHT=0
# Mode headless (0 par défaut : UI visible, plus fiable contre les captchas).
TIKTOK_PLAYWRIGHT_HEADLESS=0
# Dossier racine des profils Playwright TikTok (un sous-dossier par account_id).
# TIKTOK_PROFILE_DIR=C:\chemin\vers\playwright-profiles

# Mode Direct Post (publication directe sur le profil) :
# 0 = INBOX/brouillon (défaut, avant audit), 1 = DIRECT (publication directe).
# Doit valoir 1 pour démontrer l'UX Direct Post lors de l'enregistrement d'audit TikTok.
TIKTOK_DIRECT_POST_ENABLED=0

# Paramètres auto-post (utilisés en mode Direct API ET Playwright).
TIKTOK_AUTO_PUBLISH_PRIVACY=PUBLIC_TO_EVERYONE
TIKTOK_AUTO_PUBLISH_ALLOW_COMMENT=1
TIKTOK_AUTO_PUBLISH_ALLOW_DUET=0
TIKTOK_AUTO_PUBLISH_ALLOW_STITCH=0

# ── Adobe Express (Playwright) ───────────────────────────────
# Chemin vers le profil Playwright persistant (session Adobe)
BASE_PROFILE_PATH=C:\chemin\vers\playwright-profile

# URL de l'outil Adobe Express (Animate Characters)
URL_ADOBE=https://express.adobe.com/...

# Chemins images de fond (gauche / droite)
IMAGE_LEFT_PATH=C:\chemin\vers\image_gauche.png
IMAGE_RIGHT_PATH=C:\chemin\vers\image_droite.png

# ── Navigateur ───────────────────────────────────────────────
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
FIREFOX_PATH=C:\Program Files\Mozilla Firefox\firefox.exe

# ── Répertoire base (optionnel) ──────────────────────────────
# BASE_DIR=C:\chemin\vers\animate_video_with_adobe

# ── Playwright (optionnel) ───────────────────────────────────
HEADLESS=0
SLOWMO_MS=0
TIMEOUT_MULT=2.5
BLOCK_TRACKING=1
VERBOSE_PAGE_LOGS=0
VIDEO_SEGMENTS_DIR=video_segments
